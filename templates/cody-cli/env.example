# ===========================================
# {{PROJECT_NAME}} Environment Configuration
# ===========================================
# Copy this file to .env and replace {{PLACEHOLDERS}} with actual values
# NEVER commit .env to version control

# ===========================================
# Application
# ===========================================
ENVIRONMENT={{ENVIRONMENT}}
DEBUG={{DEBUG}}
HOST={{HOST}}
PORT={{PORT}}

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}

# ===========================================
# AINative Platform
# ===========================================
# Get your API key at https://ainative.studio
AINATIVE_API_KEY={{AINATIVE_API_KEY}}

# ZeroDB (vector storage, semantic search)
ZERODB_PROJECT_ID={{ZERODB_PROJECT_ID}}
ZERODB_API_KEY={{ZERODB_API_KEY}}

# ===========================================
# Authentication
# ===========================================
JWT_SECRET_KEY={{JWT_SECRET_KEY}}
JWT_ALGORITHM=HS256

# ===========================================
# AI Providers (BYOK — optional)
# ===========================================
OPENAI_API_KEY={{OPENAI_API_KEY}}
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}

# ===========================================
# External Services (optional)
# ===========================================
GITHUB_TOKEN={{GITHUB_TOKEN}}
